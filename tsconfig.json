{
  "compilerOptions": {
    "module": "ESNext",  // or "ES2020"
    "target": "ES2020",
    "lib": ["ES2020"],
    "sourceMap": true,
    "baseUrl": "./",
    "removeComments": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "paths": {
      "@generated/*": ["src/core/generated/*"],
      "@utils/*": ["src/utils/*"],
      "@common/*": ["src/common/*"],
      "@functional-api/*": ["src/functional-api/*"],
      "@src/*": ["src/*"]
    }
  },
  "exclude": ["./node_modules"],
  "include": ["./src/**/*.ts"]
}
